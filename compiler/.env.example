# Copy to compiler/.env.local. Never expose this value to browser code.
GPT_API_KEY=replace-with-your-gpt-relay-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-key

# Production mode requires the shared secret from root `.dev.vars`.
COMPILER_ENV=production

# Parsed documents may call GPT concurrently; MinerU remains serial.
COMPILER_GPT_CONCURRENCY=64

# The Compiler accepts only this allowlisted HTTPS parser route.
COMPILER_MINERU_URL=https://mineru.acemap.cn/file_parse

# Retrieval uses a model-specific projection under COMPILER_DATA_DIR.
RETRIEVAL_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_DENSE_MODEL_REVISION=onnx-default-v1
# Current contextual search requires GPT planning and relation classification.
RETRIEVAL_REMOTE_MODELS=true
RETRIEVAL_RRF_K=60
RETRIEVAL_CONCURRENCY=64

# Optional OpenAlex API key. DOI-matched Works are preferred; otherwise the
# official OpenAlex title/abstract Topic model runs locally.
# OPENALEX_API_KEY=replace-with-your-openalex-key

# Optional server-backed Qdrant. HTTPS is required off loopback, and an API key
# is valid only when the URL is set. Omit both for persistent local Qdrant.
# RETRIEVAL_QDRANT_URL=https://qdrant.example.internal
# RETRIEVAL_QDRANT_API_KEY=replace-with-a-private-server-key
