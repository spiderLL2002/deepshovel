{
  "name": "deepshovel-2",
  "version": "1.1.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "bash scripts/dev-local.sh",
    "dev:compiler": "bash compiler/scripts/dev-local.sh",
    "dev:serve": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run test:node",
    "test:node": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "verify": "bash scripts/verify-all.sh",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/project-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/project-env.sh -- drizzle-kit generate",
    "contract:generate": "node scripts/generate-shared-contract.mjs",
    "contract:check": "node scripts/generate-shared-contract.mjs --check"
  },
  "dependencies": {
    "@cosmos.gl/graph": "^3.4.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "drizzle-orm": "0.45.2",
    "katex": "0.18.4",
    "next": "16.2.6",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "DeepShovel \u00b7 Scientific Evidence Graph",
  "license": "AGPL-3.0-only"
}
