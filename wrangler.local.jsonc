{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deepshovel-2",
  "main": "./worker/index.ts",
  // Must not exceed the compatibility date supported by the pinned local
  // workerd binary. Production hosting uses its own generated configuration.
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "COMPILER_BASE_URL": "http://127.0.0.1:8011"
  },
  "secrets": {
    "required": ["COMPILER_SHARED_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deepshovel-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "deepshovel-local"
    }
  ]
}
